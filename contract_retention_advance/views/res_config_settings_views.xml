<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_contract" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.contract</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Contracting Retention &amp; Advance Management" name="contract_retention_setting_block">
                    <setting id="contract_retention_setting" title="Configure default retention account and percentage for contracting invoices.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="contract_retention_account_id" class="col-lg-4 o_light_label"/>
                                <field name="contract_retention_account_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="contract_retention_percentage" class="col-lg-4 o_light_label"/>
                                <field name="contract_retention_percentage"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
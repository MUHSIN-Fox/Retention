<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_retention_advance_report_wizard_form" model="ir.ui.view">
        <field name="name">retention.advance.report.wizard.form</field>
        <field name="model">retention.advance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Retention &amp; Advance Balance Report">
                <sheet>
                    <div class="oe_title">
                        <h1>Retention &amp; Advance Report</h1>
                    </div>
                    <group>
                        <group>
                            <field name="as_at_date"/>
                            <field name="project_name" placeholder="e.g. Sales Order / Project Name"/>
                        </group>
                        <group>
                            <field name="partner_ids" widget="many2many_tags" placeholder="All Customers"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Export to Excel" name="action_export_excel" type="object" class="btn-primary" icon="fa-file-excel-o"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_retention_advance_report_wizard" model="ir.actions.act_window">
        <field name="name">Retention &amp; Advance Report</field>
        <field name="res_model">retention.advance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item under Invoicing / Accounting Reporting -->
    <menuitem id="menu_retention_advance_report"
              name="Retention &amp; Advance Report"
              parent="account.menu_finance_reports"
              action="action_retention_advance_report_wizard"
              sequence="25"/>

</odoo>